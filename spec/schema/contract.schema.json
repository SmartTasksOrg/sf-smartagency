{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SmartTasksOrg/sf-smartagency/spec/schema/contract.schema.json",
  "title": "SmartAgency contract (smartagency.contract/1)",
  "description": "What one AI agent may do, signed by an issuer. Semantic rules that a schema cannot express are in spec/SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "issuer",
    "subject",
    "grants",
    "limits",
    "not_before",
    "expires"
  ],
  "properties": {
    "schema": {
      "const": "smartagency.contract/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{32}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[!-~]{1,256}$"
    },
    "roles": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,64}$"
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/definitions/grant"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "max_tool_calls",
        "max_depth",
        "max_influence"
      ],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "max_influence": {
          "enum": [
            "inert",
            "informational",
            "persuasive",
            "adaptive",
            "autonomous"
          ]
        },
        "pressure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "escalation_threshold": {
              "$ref": "#/definitions/decimal"
            },
            "release_threshold": {
              "$ref": "#/definitions/decimal"
            },
            "dissipation_per_step": {
              "$ref": "#/definitions/decimal"
            },
            "token_coefficient": {
              "$ref": "#/definitions/decimal"
            },
            "tool_coefficient": {
              "$ref": "#/definitions/decimal"
            },
            "depth_coefficient": {
              "$ref": "#/definitions/decimal"
            }
          }
        }
      }
    },
    "composite": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "deny_sequence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
          },
          "deny_sequence": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "$ref": "#/definitions/pattern"
            }
          }
        }
      }
    },
    "not_before": {
      "$ref": "#/definitions/time"
    },
    "expires": {
      "$ref": "#/definitions/time"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  },
  "definitions": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})(\\.[0-9]{1,9})?$"
    },
    "verb": {
      "type": "string",
      "pattern": "^(\\*|[a-z]+(\\.[a-z]+)?|x-[a-z0-9]+-[a-z0-9]+(\\.[a-z0-9]+)*)$",
      "maxLength": 64
    },
    "resource": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~:@+=*/-]{1,256}$"
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "resource"
      ],
      "properties": {
        "verb": {
          "$ref": "#/definitions/verb"
        },
        "resource": {
          "$ref": "#/definitions/resource"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "resource",
        "effect"
      ],
      "properties": {
        "verb": {
          "$ref": "#/definitions/verb"
        },
        "resource": {
          "$ref": "#/definitions/resource"
        },
        "effect": {
          "enum": [
            "allow",
            "deny"
          ]
        }
      }
    }
  }
}
